# Copy to ui-next/.env and adjust. Real environment variables override these.
# Read by ecosystem.config.js (pm2); NEXT_PUBLIC_BASE_PATH is also read by `next build`.
# NOTE: `npm run dev`/`start` use the hardcoded -p in package.json and IGNORE PORT/HOSTNAME below.
# ngrok/exposure is handled by the shared gateway at ~/IdeaProjects/gateway, not here.

# Basic Auth for the UI (empty = no auth, loopback only). Required when exposed via the gateway.
UI_BASIC_AUTH=userName:Password

# App port. The gateway routes /ai → this PORT (match AI_PORT in the gateway .env).
PORT=5000
HOSTNAME=127.0.0.1

# Path prefix this app is served under behind the gateway. BAKED INTO THE BUILD.
# Must equal the gateway's route prefix for this app. Empty = serve at root (standalone, no proxy).
NEXT_PUBLIC_BASE_PATH=/ai
