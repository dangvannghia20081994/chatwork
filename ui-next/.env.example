# Copy to ui-next/.env and adjust. Real environment variables override these.
# Read by ecosystem.config.js (pm2); NEXT_PUBLIC_BASE_PATH is also read by `next build`.
# NOTE: `npm run dev`/`start` use the hardcoded -p in package.json and IGNORE PORT/HOSTNAME below.
# ngrok/exposure is handled by the shared gateway at ~/IdeaProjects/gateway, not here.

# Basic Auth for the UI (empty = no auth, loopback only). Required when exposed via the gateway.
UI_BASIC_AUTH=userName:Password

# App port. The gateway routes /ai → this PORT (match AI_PORT in the gateway .env).
PORT=5000
HOSTNAME=127.0.0.1

# Path prefix this app is served under behind the gateway. BAKED INTO THE BUILD.
# Must equal the gateway's route prefix for this app. Empty = serve at root (standalone, no proxy).
NEXT_PUBLIC_BASE_PATH=/ai

# Parent dir holding the sibling project repos (rezil-esms*, story, ai-film-studio). config/*.json
# store repo paths as bare folder names relative to this. Default = parent of this repo (repos
# checked out side-by-side). Set this to relocate on another machine without editing config/*.json.
# REZIL_ROOT=/home/youruser/IdeaProjects

# --- Telegram bot (optional) -------------------------------------------------
# Turns Telegram into a 2nd chat channel driving the agent (long-polling, started in-process by
# instrumentation.js). Leave TELEGRAM_BOT_TOKEN empty to keep it disabled.
# 1) Create a bot with @BotFather → paste the token below.
# 2) Start with an empty allowlist, message the bot once → it replies with your chat id.
# 3) Put that id in TELEGRAM_ALLOWED_CHAT_IDS (comma-separated for several) and restart pm2.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
# Which project the agent works on: rezil | story | film | free  (default rezil)
TELEGRAM_PROJECT=rezil
# "1" = allow Edit/Write/Bash (agent can change code); default off = read-only Q&A.
TELEGRAM_CAN_EDIT=0
# Hard cap per message run, ms (default 600000 = 10 min).
TELEGRAM_TIMEOUT_MS=600000
