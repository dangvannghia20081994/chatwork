# Copy to ui-next/.env and adjust. Real environment variables override these.
# Read by ecosystem.config.js (pm2). NOTE: `npm run dev`/`start` use the hardcoded
# -p/-H in package.json and IGNORE PORT/HOSTNAME below.

# Basic Auth for the UI (empty = no auth, loopback only). Required when exposed via ngrok.
UI_BASIC_AUTH=userName:Password

# Port for pm2 (Next + ngrok). Default 5000.
PORT=5000
# Host/interface for pm2. 127.0.0.1 = loopback only.
HOSTNAME=127.0.0.1
# ngrok reserved domain the tunnel forwards into PORT.
NGROK_DOMAIN=these-cadet-unaired.ngrok-free.dev
